{
  "default": "openai",
  "models": {
    "openai": {
      "model": "gpt-4.1",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "max_steps": 24
    },
    "local": {
      "model": "your-local-model",
      "base_url": "http://127.0.0.1:1234/v1",
      "api_key_env": "LOCAL_MODEL_API_KEY",
      "max_steps": 24
    }
  }
}
